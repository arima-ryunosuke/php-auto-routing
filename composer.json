{
  "config": {
    "platform": {
      "php": "8.0.2"
    }
  },
  "name": "ryunosuke/microute",
  "type": "framework",
  "description": "php class based routing",
  "license": "MIT",
  "authors": [
    {
      "name": "ryunosuke",
      "email": "ryunosuke.arima@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.0",
    "symfony/http-kernel": "5.*|6.*|7.*",
    "symfony/mime": "5.*|6.*|7.*",
    "psr/http-message": "1.*|2.*",
    "psr/simple-cache": "*",
    "psr/log": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "9.*",
    "symfony/browser-kit": "5.*|6.*|7.*",
    "symfony/css-selector": "5.*|6.*|7.*",
    "ryunosuke/simple-cache": "1.*"
  },
  "autoload": {
    "psr-4": {
      "ryunosuke\\microute\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ryunosuke\\Test\\": "tests/Test",
      "example\\application\\": "example/app/class/"
    }
  },
  "scripts": {
    "example": [
      "@php -S 0.0.0.0:8000 -t example/public example/public/router.php"
    ],
    "build": [
      "@test"
    ],
    "test": [
      "SYMFONY_VERSION=5 vendor/bin/phpunit --configuration=tests/phpunit.xml",
      "SYMFONY_VERSION=6 vendor/bin/phpunit --configuration=tests/phpunit.xml",
      "SYMFONY_VERSION=7 vendor/bin/phpunit --configuration=tests/phpunit.xml"
    ]
  }
}
